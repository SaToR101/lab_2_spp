# Скопируйте в .env (рядом с docker-compose.yml) и при необходимости измените.
# Файл .env не попадает в git — здесь можно хранить пароли.

JWT_ACCESS_SECRET=change_me_to_a_long_random_string

# --- Почта ----------------------------------------------------------------
# По умолчанию (строки ниже закомментированы) письма уходят в Mailpit:
# откройте http://localhost:8025 — там будет письмо со ссылкой для сброса пароля.
#
# Чтобы письма приходили на настоящий ящик, раскомментируйте блок для Gmail
# (нужна двухэтапная аутентификация и «пароль приложения»:
#  https://myaccount.google.com/apppasswords — 16 символов, пробелы можно оставить):
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.name@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# MAIL_FROM=your.name@gmail.com
#
# Яндекс: SMTP_HOST=smtp.yandex.ru, SMTP_PORT=465, SMTP_SECURE=true (тоже пароль приложения).
# Outlook/Hotmail для личных аккаунтов больше не поддерживает вход в SMTP по паролю — используйте Gmail или Яндекс.

# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Admin12345
